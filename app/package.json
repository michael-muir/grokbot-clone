{
  "name": "grokbot-clone-app",
  "version": "0.1.0",
  "private": true,
  "description": "GrokBot Clone desktop app: Electron + React, talking to the agent gateway",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "smoke": "electron-vite build && electron . --smoke",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.3.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
