{
  "name": "smarty-prompts-app",
  "productName": "SmartyPrompts",
  "version": "0.1.0",
  "private": true,
  "description": "SmartyPrompts desktop app: Electron + React, talking to the agent gateway",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "smoke": "electron-vite build && electron . --smoke",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-virtual": "3.14.26",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.3.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
