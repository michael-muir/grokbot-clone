# Copy to .env and fill in. Never commit .env.

# Claude provider (Claude Agent SDK). Use an Anthropic API key; claude.ai logins are not allowed for third-party products.
ANTHROPIC_API_KEY=

# Optional: require "Authorization: Bearer <token>" on every request to the gateway.
GATEWAY_TOKEN=

# Optional overrides
PORT=8787
DATA_DIR=../data
CLAUDE_MODEL=claude-opus-5-5
