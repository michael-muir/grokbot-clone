# Copy to .env and fill in. Never commit .env.

# Claude provider (Claude Agent SDK). Use an Anthropic API key; claude.ai logins are not allowed for third-party products.
ANTHROPIC_API_KEY=

# Optional: require "Authorization: Bearer <token>" on every request to the gateway.
GATEWAY_TOKEN=

# Optional overrides
PORT=8787
DATA_DIR=../data
CLAUDE_MODEL=claude-opus-5-5

# OpenAI-compatible providers. Set a key to use a provider; <PREFIX>_MODEL sets its default model and
# <PREFIX>_BASE_URL points it at another server.
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_MODEL=
# XAI_MODEL=
# OPENROUTER_MODEL=

# Local servers need no key. Without a model, the first one the server lists is used.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=
