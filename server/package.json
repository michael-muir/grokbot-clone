{
  "name": "smarty-prompts-server",
  "version": "0.1.0",
  "private": true,
  "description": "Agent gateway for SmartyPrompts: one provider interface for Claude, OpenAI-compatible APIs, local models and Gemini",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:live": "node --env-file-if-exists=.env --test test/live/*.live.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.331",
    "@napi-rs/keyring": "2.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
